# Django - OBRIGATORIO: Altere para valores seguros!
SECRET_KEY=gere-uma-chave-secreta-forte-aqui
DEBUG=False
ALLOWED_HOSTS=.railway.app,seu-dominio.com.br

# Database - Railway PostgreSQL (sera preenchido automaticamente se usar o addon)
DATABASE_URL=postgresql://user:password@host:port/database

# Redis - Railway Redis (sera preenchido automaticamente se usar o addon)
REDIS_URL=redis://default:password@host:port

# CORS e CSRF - Adicione seu dominio do Railway
CORS_ALLOWED_ORIGINS=https://seu-app.railway.app,https://seu-dominio.com.br
CSRF_TRUSTED_ORIGINS=https://seu-app.railway.app,https://seu-dominio.com.br

# WAHA (WhatsApp API) - Configure com seu servidor WAHA
WAHA_URL=https://seu-waha.railway.app
WAHA_SESSION=default
WAHA_API_KEY=sua-api-key-segura
