# WAHA - Configuracoes de Producao Railway

# API Key para autenticacao (OBRIGATORIO - use uma chave forte!)
WAHA_API_KEY=sua-api-key-segura-aqui

# Configuracoes do Dashboard
WAHA_DASHBOARD_ENABLED=true
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=senha-forte-aqui

# Swagger API Docs
WHATSAPP_SWAGGER_ENABLED=true
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=senha-forte-aqui

# Engine do WhatsApp (GOWS e mais leve e recomendado)
WHATSAPP_DEFAULT_ENGINE=GOWS

# QR Code
WAHA_PRINT_QR=true

# Webhook - URL do N8N (substitua pelo seu dominio)
WHATSAPP_HOOK_URL=https://seu-n8n.up.railway.app/webhook/waha-inbound
WHATSAPP_HOOK_EVENTS=message,session.status
WHATSAPP_HOOK_RETRIES_POLICY=linear
WHATSAPP_HOOK_RETRIES_DELAY_SECONDS=2
WHATSAPP_HOOK_RETRIES_ATTEMPTS=4

# Timezone
TZ=America/Sao_Paulo
