# N8N - Configuracoes de Producao Railway

# Timezone
TZ=America/Sao_Paulo

# URL publica do N8N (substitua pelo seu dominio Railway)
N8N_HOST=seu-n8n.up.railway.app
N8N_PROTOCOL=https
WEBHOOK_URL=https://seu-n8n.up.railway.app
N8N_EDITOR_BASE_URL=https://seu-n8n.up.railway.app

# Autenticacao basica (OBRIGATORIO em producao!)
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=senha-muito-forte-aqui

# Chave de criptografia (OBRIGATORIO - gere uma chave unica!)
N8N_ENCRYPTION_KEY=gere-uma-chave-de-32-caracteres-aqui

# Banco de dados PostgreSQL (Railway preenche automaticamente)
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=${PGHOST}
DB_POSTGRESDB_PORT=${PGPORT}
DB_POSTGRESDB_DATABASE=${PGDATABASE}
DB_POSTGRESDB_USER=${PGUSER}
DB_POSTGRESDB_PASSWORD=${PGPASSWORD}

# Redis para filas (opcional mas recomendado)
# QUEUE_BULL_REDIS_HOST=
# QUEUE_BULL_REDIS_PORT=6379

# Seguranca
N8N_SECURE_COOKIE=true

# Execucoes - manter historico
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=true
