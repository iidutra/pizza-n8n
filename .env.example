# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://postgres:postgres@db:5432/pizzaria
DB_NAME=pizzaria
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# WAHA (WhatsApp API)
WAHA_URL=http://waha:3000
WAHA_SESSION=default

# Anthropic API (LLM — Claude Haiku)
# Obtenha em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_LLM_MODEL=claude-haiku-4-5

# Groq API (transcrição de áudio Whisper — STT)
# Obtenha em: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
